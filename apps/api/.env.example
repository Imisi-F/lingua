# Copy this to apps/api/.env and fill in real values. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the direct connection, port 5432, not the pooler, for a long-lived
# backend process). Replace [YOUR-PASSWORD] with your DB password.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# DeepSeek: platform.deepseek.com -> API keys -> Create new key
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Which langpacks/<name>/ directory is currently active
ACTIVE_LANGPACK=mandarin
