# Copy this to apps/api/.env and fill in real values. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" tab, not "Direct connection" - Supabase's direct
# connection host is IPv6-only and won't resolve on most networks (confirmed
# the hard way). Note the username becomes postgres.<project-ref> on the
# pooler. Replace [YOUR-PASSWORD] with your DB password.
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# DeepSeek: platform.deepseek.com -> API keys -> Create new key
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Which langpacks/<name>/ directory is currently active
ACTIVE_LANGPACK=mandarin

# Optional but recommended once you're using Phase 3 speech features:
# huggingface.co/settings/tokens -> New token (Read is enough). Without
# this, model downloads (MMS, faster-whisper's base model) still work, just
# rate-limited as an unauthenticated client - matters more once the Fly
# machine starts sleeping/waking and re-checking/downloading on cold starts.
HF_TOKEN=hf_your_token_here
