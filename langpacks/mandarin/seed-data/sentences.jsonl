{"id": "s001", "text": "你好!", "reading": "Nǐ hǎo!", "translation": "Hello!"}
{"id": "s002", "text": "你好吗?", "reading": "Nǐ hǎo ma?", "translation": "How are you?"}
{"id": "s003", "text": "我很好,谢谢。", "reading": "Wǒ hěn hǎo, xièxiè.", "translation": "I'm very good, thank you."}
{"id": "s004", "text": "你叫什么名字?", "reading": "Nǐ jiào shénme míngzi?", "translation": "What is your name?"}
{"id": "s005", "text": "她是我的朋友。", "reading": "Tā shì wǒ de péngyou.", "translation": "She is my friend."}
{"id": "s006", "text": "他是老师,我是学生。", "reading": "Tā shì lǎoshī, wǒ shì xuéshēng.", "translation": "He is the teacher, I am the student."}
{"id": "s007", "text": "我喜欢喝茶。", "reading": "Wǒ xǐhuan hē chá.", "translation": "I like to drink tea."}
{"id": "s008", "text": "你想吃米饭吗?", "reading": "Nǐ xiǎng chī mǐfàn ma?", "translation": "Do you want to eat rice?"}
{"id": "s009", "text": "今天很好。", "reading": "Jīntiān hěn hǎo.", "translation": "Today is very nice."}
{"id": "s010", "text": "明天我去那里。", "reading": "Míngtiān wǒ qù nàlǐ.", "translation": "Tomorrow I will go there."}
{"id": "s011", "text": "我爱我的家。", "reading": "Wǒ ài wǒ de jiā.", "translation": "I love my family."}
{"id": "s012", "text": "没关系,再见!", "reading": "Méi guānxi, zàijiàn!", "translation": "It's okay, goodbye!"}
